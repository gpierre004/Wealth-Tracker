<?xml version="1.0" encoding="UTF-8"?><record_update>
    <sys_dictionary action="INSERT_OR_UPDATE" element="u_unrealized_gain_loss" table="x_1796514_invest_0_invest_position">
        <active>true</active>
        <array>false</array>
        <attributes/>
        <audit>false</audit>
        <calculation><![CDATA[(function calculatedFieldValue(current) {

	var quantity = parseFloat(current.u_quantity_held || 0);
	var costBasis = parseFloat(current.u_average_cost_basis || 0);
	var company = current.u_company;
	var marketValue = 0;
	if (company && quantity > 0) {
		// Get latest close price for the company
		var price = new GlideRecord('x_1796514_invest_0_invest_price');
		price.addQuery('u_company', company);
		price.orderByDesc('u_date');
		price.setLimit(1);
		price.query();
		if (price.next()) {
			var closePrice = parseFloat(price.u_close_price || 0);
			marketValue = quantity * closePrice;
		}
	}
	return marketValue - (quantity * costBasis);

})(current);]]></calculation>
