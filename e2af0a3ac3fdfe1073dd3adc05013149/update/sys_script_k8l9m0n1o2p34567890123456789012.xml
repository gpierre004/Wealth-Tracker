        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    // Set line number
    if (current.u_journal_entry && !current.u_line_number) {
        var maxLine = 0;
        var lines = new GlideRecord('x_1796514_invest_0_invest_journal_line');
        lines.addQuery('u_journal_entry', current.u_journal_entry);
        lines.addNotNullQuery('u_line_number');
        lines.orderByDesc('u_line_number');
        lines.setLimit(1);
        lines.query();
        if (lines.next()) {
            maxLine = parseInt(lines.u_line_number);
        }
        current.u_line_number = maxLine + 1;
    }

})(current, previous);]]></script>
